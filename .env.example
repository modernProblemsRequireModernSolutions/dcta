# ── DCTA environment ──────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env. Only .env.example is tracked.

# LLM (OpenAI-compatible client; can point at Tencent Hunyuan or any compatible endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Tencent Cloud ASR (optional; browser Web Speech API is the automatic fallback)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Execution Gateway (trusted zone, separate process)
GATEWAY_URL=http://localhost:4001
# Shared read-only key the web app sends to the gateway's read endpoints
GATEWAY_SHARED_READ_KEY=

# Web app port
PORT=3000
